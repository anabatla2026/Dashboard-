# In local dev you don't need this — Vite's dev-server proxy forwards
# /api/* to http://localhost:4000 (see vite.config.js).
#
# For a production build deployed on its own (e.g. this client on Vercel,
# the server hosted elsewhere), set this to the server's public URL so the
# built app knows where to fetch data from:
# VITE_API_URL=https://your-server-host.example.com
